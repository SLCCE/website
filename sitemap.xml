  <url>
    <loc>https://www.slcce-inc.org/news/</loc>
    <lastmod>{% if site.posts.size > 0 %}{{ site.posts.first.date | date: "%Y-%m-%d" }}{% else %}2026-10-01{% endif %}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
{%- for t in site.news_types %}
  <url>
    <loc>{{ t[1].url | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.5</priority>
  </url>
{%- endfor %}
{%- for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.last_modified_at | default: post.date | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.5</priority>
  </url>
{%- endfor %}
</urlset>
